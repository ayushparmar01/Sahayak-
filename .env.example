# ==========================================
# SAHAYAK — Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Local development default: SQLite
DATABASE_URL=sqlite+aiosqlite:///./sahayak.db
# Production target example:
# DATABASE_URL=postgresql+asyncpg://sahayak_user:password@localhost:5432/sahayak_db

# Security & Session
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Provider-independent adapter layer)
LLM_PROVIDER=anthropic  # options: anthropic, openai, mock
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Indic Voice Providers (ASR / TTS)
VOICE_PROVIDER=sarvam  # options: sarvam, bhashini, whisper, browser_mock
SARVAM_API_KEY=your_sarvam_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id_here

# Document OCR Provider
OCR_PROVIDER=vision_llm  # options: vision_llm, mock, tesseract

# Optional / Roadmap Integrations (Set to false until official credentials exist)
ENABLE_WHATSAPP_TWILIO=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

ENABLE_DIGILOCKER=false
ENABLE_UMANG=false
ENABLE_CSC_WORKFLOW=false
